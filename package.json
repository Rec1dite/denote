{
  "name": "denote",
  "displayName": "Denote",
  "description": "Interactive window for JavaScript/TypeScript using the Deno Jupyter kernel, with `// %%` cell markers",
  "version": "0.1.0",
  "publisher": "denote",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Notebooks",
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "denote.runCell",
        "title": "Denote: Run Cell"
      },
      {
        "command": "denote.runCellAndAdvance",
        "title": "Denote: Run Cell and Advance"
      },
      {
        "command": "denote.execSelectionInInteractive",
        "title": "Denote: Run Selection/Line in Interactive Window"
      },
      {
        "command": "denote.insertCellBelow",
        "title": "Denote: Insert Cell Below"
      },
      {
        "command": "denote.insertCellAbove",
        "title": "Denote: Insert Cell Above"
      },
      {
        "command": "denote.runAllCells",
        "title": "Denote: Run All Cells"
      },
      {
        "command": "denote.runAllCellsAbove",
        "title": "Denote: Run All Cells Above"
      },
      {
        "command": "denote.runAllCellsBelow",
        "title": "Denote: Run All Cells Below"
      },
      {
        "command": "denote.clearAllCells",
        "title": "Clear All",
        "category": "Denote",
        "icon": "$(clear-all)"
      },
      {
        "command": "denote.restartKernel",
        "title": "Restart",
        "category": "Denote",
        "icon": "$(refresh)"
      },
      {
        "command": "denote.exportAsNotebook",
        "title": "Save",
        "category": "Denote",
        "icon": "$(save)"
      },
      {
        "command": "denote.export",
        "title": "Export",
        "category": "Denote",
        "icon": "$(export)"
      },
      {
        "command": "denote.expandAllCells",
        "title": "Expand",
        "category": "Denote",
        "icon": "$(expand-all)"
      },
      {
        "command": "denote.collapseAllCells",
        "title": "Collapse",
        "category": "Denote",
        "icon": "$(collapse-all)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "denote.execSelectionInInteractive",
          "when": "editorHasSelection && editorLangId =~ /javascript|typescript/",
          "group": "denote@1"
        }
      ],
      "interactive/toolbar": [
        {
          "command": "denote.clearAllCells",
          "when": "notebookKernel =~ /^denote\\.denote\\// && isWorkspaceTrusted",
          "group": "navigation@0"
        },
        {
          "command": "denote.restartKernel",
          "when": "notebookKernel =~ /^denote\\.denote\\// && isWorkspaceTrusted",
          "group": "navigation@1"
        },
        {
          "command": "denote.exportAsNotebook",
          "when": "notebookKernel =~ /^denote\\.denote\\// && isWorkspaceTrusted",
          "group": "navigation@4"
        },
        {
          "command": "denote.export",
          "when": "notebookKernel =~ /^denote\\.denote\\// && isWorkspaceTrusted",
          "group": "navigation@5"
        },
        {
          "command": "denote.expandAllCells",
          "when": "notebookKernel =~ /^denote\\.denote\\// && isWorkspaceTrusted",
          "group": "navigation@6"
        },
        {
          "command": "denote.collapseAllCells",
          "when": "notebookKernel =~ /^denote\\.denote\\// && isWorkspaceTrusted",
          "group": "navigation@7"
        }
      ]
    },
    "keybindings": [
      {
        "command": "denote.runCell",
        "key": "ctrl+enter",
        "when": "editorTextFocus && editorLangId =~ /javascript|typescript/ && !notebookEditorFocused"
      },
      {
        "command": "denote.runCellAndAdvance",
        "key": "shift+enter",
        "when": "editorTextFocus && editorLangId =~ /javascript|typescript/ && !notebookEditorFocused"
      }
    ],
    "configuration": {
      "title": "Denote",
      "properties": {
        "denote.denoPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `deno` executable used to start the Jupyter kernel. When empty, the registered `deno` kernelspec or `~/.deno/bin/deno` is used."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "clean": "rm -rf out",
    "package": "vsce package --out denote-${npm_package_version}.vsix"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.59.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "zeromq": "^6.8.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/denote-vscode/denote.git"
  }
}
